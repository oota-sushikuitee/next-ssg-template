{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"github>oota-sushikuitee/renovate-config",
		"customManagers:githubActionsVersions"
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Update tools pinned in package.json scripts as npx <package>@<version>",
			"managerFilePatterns": ["/^package\\.json$/"],
			"matchStrings": [
				"npx (?<depName>(?:@[\\w.-]+/)?[\\w.-]+)@(?<currentValue>\\d[^\\s\"]*)"
			],
			"datasourceTemplate": "npm"
		}
	],
	"packageRules": [
		{
			"allowedVersions": "/^([0-9]*[02468])\\./",
			"groupName": "Node.js dependencies",
			"matchPackageNames": ["node", "@types/node"]
		},
		{
			"groupName": "@types dependencies",
			"matchPackageNames": ["/^@types//"]
		},
		{
			"groupName": "linting dependencies",
			"matchPackageNames": ["/^@biomejs//"]
		}
	]
}

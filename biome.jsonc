{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/out",
			"!**/coverage",
			"!**/*.log",
			"!**/*.lock",
			"!**/.next",
			"!**/.vercel"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		// `preset: all` also turns on every framework domain; keep only the
		// frameworks this project actually uses (React, Next.js, Tailwind).
		"domains": {
			"astro": "none",
			"drizzle": "none",
			"playwright": "none",
			"qwik": "none",
			"reactNative": "none",
			"solid": "none",
			"svelte": "none",
			"tanstackQuery": "none",
			"turborepo": "none",
			"vue": "none"
		},
		"rules": {
			"preset": "all",
			"correctness": {
				// `moduleResolution: bundler` resolves extensionless specifiers, and
				// `.ts` specifiers would additionally need `allowImportingTsExtensions`.
				"useImportExtensions": "off"
			},
			"style": {
				// Next.js file conventions (pages, layouts, metadata routes) and the
				// next/postcss configs must default-export.
				"noDefaultExport": "off",
				// Page copy is written inline; there is no i18n layer to source it from.
				"noJsxLiterals": "off",
				"useComponentExportOnlyModules": {
					"level": "on",
					"options": { "allowExportNames": ["metadata"] }
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noUnknownAtRules": "off"
					}
				}
			}
		}
	]
}
